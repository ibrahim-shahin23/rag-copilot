# Copy this file to .env and fill in real values. .env is git-ignored.
# Place it at the project root (same level as README.md) — it's loaded from
# there regardless of which directory you run the CLI from.

# Completion provider (Gemini). Leave unset to use the offline extractive
# fallback instead — see infrastructure/config.py for the fallback chain.
GEMINI_API_KEY=

# Embedding provider (OpenAI). Leave unset to use the offline local
# TF-IDF embedder instead.
OPENAI_API_KEY=
